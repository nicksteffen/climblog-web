---
import { site } from '../data/site';
---

<section class="section" id="download">
  <div class="wrap">
    <div class="card cta">
      <p class="eyebrow">Beta</p>
      <h2>
        {site.downloadReady
          ? 'Try the beta.'
          : 'The beta is on the way.'}
      </h2>

      {site.downloadReady ? (
        <>
          <p class="lede cta__lede">
            Builds are distributed through Expo. Open the link on the device you
            want to test with — it will walk you through the install.
          </p>
          <div class="cta__actions">
            <a class="btn btn--primary" href={site.downloadUrl}>
              {site.downloadLabel}
            </a>
          </div>
        </>
      ) : (
        <>
          <p class="lede cta__lede">
            We are still putting the finishing touches on the first build. Check
            back here — the download link will appear on this page.
          </p>
        </>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 56px 40px;
    text-align: center;
    border-color: var(--border-pink);
  }

  h2 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-top: 14px;
  }

  .cta__lede {
    margin: 18px auto 0;
    text-align: center;
  }

  .cta__actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
