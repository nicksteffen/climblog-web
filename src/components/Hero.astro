---
import { site, highlights } from '../data/site';
import logbook from '../assets/shots/02-logbook.png';
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Bouldering session tracker</p>

      <h1>
        Climb more.<br />
        <span class="accent">Guess less.</span>
      </h1>

      <p class="hero__lede lede">
        Get every climb into your logbook in seconds — warm-ups, flashes, and the
        project you keep falling off. Then see exactly what you did.
      </p>

      <div class="hero__actions">
        {site.downloadReady ? (
          <a class="btn btn--primary" href={site.downloadUrl}>Download the beta</a>
        ) : (
          <a class="btn btn--primary" href="#download">Get notified</a>
        )}
        <a class="btn btn--ghost" href="#features">See how it works</a>
      </div>

      <dl class="hero__stats">
        {highlights.map((h) => (
          <div>
            <dt>{h.value}</dt>
            <dd>{h.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero__shot">
      <div class="phone">
        <img
          src={logbook.src}
          width={logbook.width}
          height={logbook.height}
          alt="The VertX logbook, showing active routes as photo cards with grade badges."
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 72px 40px;
  }

  .hero__grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.1rem);
    margin-block: 18px 20px;
  }

  .accent {
    background: linear-gradient(100deg, var(--punch-pink), var(--cyan-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    font-size: 1.2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .hero__stats {
    display: grid;
    gap: 18px;
    margin: 44px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .hero__stats dt {
    font-weight: 600;
    font-size: 1.02rem;
  }

  .hero__stats dd {
    margin: 2px 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* Phone frame — mirrors the app's rounded, glassy card treatment */
  .hero__shot {
    display: flex;
    justify-content: center;
  }

  .phone {
    position: relative;
    width: min(300px, 100%);
    border-radius: 40px;
    padding: 10px;
    background: linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.16),
      rgba(255, 255, 255, 0.03)
    );
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card), var(--shadow-glow);
  }

  .phone img {
    border-radius: 32px;
  }

  @media (min-width: 700px) {
    .hero__stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 980px) {
    .hero {
      padding-block: 104px 56px;
    }
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 72px;
    }
  }
</style>
