---
import { features, moreFeatures } from '../data/site';
---

<section class="section" id="features">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>Log fast. Understand it later.</h2>
    <p class="lede" style="margin-top:16px">
      Mid-session you want to be climbing, not typing. Get each climb down in
      seconds, then let the numbers show you what the session actually was.
    </p>

    <ol class="steps">
      {features.map((f, i) => (
        <li class="card step">
          <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="step__icon" aria-hidden="true">{f.icon}</span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ol>

    <p class="more__heading">Also included</p>
    <ul class="more">
      {moreFeatures.map((f) => (
        <li class="more__item">
          <span class="more__icon" aria-hidden="true">{f.icon}</span>
          <div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin-top: 14px;
  }

  .steps {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  .step {
    position: relative;
    padding: 30px 28px;
  }

  .step__num {
    position: absolute;
    top: 22px;
    right: 26px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .step__icon {
    display: block;
    font-size: 1.7rem;
    margin-bottom: 16px;
  }

  .step h3 {
    font-size: 1.2rem;
    margin-bottom: 10px;
  }

  .step p {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  /* Secondary capabilities — deliberately quieter than the main loop, so the
     page does not over-promise where the real value is. */
  .more__heading {
    margin-top: 56px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .more {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  .more__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .more__icon {
    font-size: 1.15rem;
    line-height: 1.5;
    flex-shrink: 0;
  }

  .more__item h3 {
    font-size: 0.97rem;
    margin-bottom: 3px;
  }

  .more__item p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  @media (min-width: 700px) {
    .more {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 32px;
    }
  }

  @media (min-width: 860px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
